APP_ENV=development
PORT=8000
SEED_DEMO=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# PostgreSQL (port host 55432 agar tidak bentrok dengan PG host)
DATABASE_URL=postgres://pantara:pantara_dev_secret@127.0.0.1:55432/pantara_db?sslmode=disable
DB_MAX_CONNS=80
DB_MIN_CONNS=15

# Redis (opsional, fallback aman ke in-memory saat kosong)
REDIS_URL=redis://127.0.0.1:16379/0

# JWT & Session Security (wajib ganti secret >= 32 char di produksi!)
JWT_SECRET=pantara-dev-jwt-secret-change-in-production-32bytes-min
# true | false | auto (auto mengikuti header X-Forwarded-Proto dari reverse proxy Dokploy/Traefik)
COOKIE_SECURE=auto
COOKIE_DOMAIN=

# AI Task DNA (kosong = otomatis pakai deterministic 5-sample fallback)
AI_PROVIDER_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=15

# SMTP Mailer (kosong = log link undangan/reset ke stdout dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@pantara.id
APP_BASE_URL=http://localhost:3000
